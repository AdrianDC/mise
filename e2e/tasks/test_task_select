#!/usr/bin/env bash

# `mise select` and `mise run --select`, driven through a PTY.
export CI=0

cat >mise.toml <<'TOML'
[tasks.build]
run = "echo ran-build"
[tasks.lint]
alias = "l"
run = "echo ran-lint"
[tasks."test:unit"]
run = "echo ran-test-unit"
[tasks."test:e2e"]
run = "echo ran-test-e2e"
TOML

# The menu needs a terminal.
assert_fail_contains "mise select </dev/null" "requires an interactive terminal"
assert_fail_contains "mise run --select </dev/null" "requires an interactive terminal"

cat >select.py <<'PY'
import os
import pty
import select
import subprocess
import sys

def run(args, keys):
    """Run mise on a PTY, press `keys` once the menu shows, return stdout."""
    master, slave = pty.openpty()
    proc = subprocess.Popen(
        args, stdin=slave, stdout=subprocess.PIPE, stderr=slave, text=True
    )
    os.close(slave)
    screen = b""
    while b"Select tasks to run" not in screen:
        ready, _, _ = select.select([master], [], [], 30)
        assert ready, screen
        screen += os.read(master, 4096)
    for key in keys:
        os.write(master, key.encode())
    out = proc.stdout.read()
    proc.wait()
    os.close(master)
    return out

ran = lambda out: [line for line in out.split() if line.startswith("ran-")]
mode = sys.argv[1]
if mode == "presets":
    # Presets: a task, an alias, and a folder.
    out = run(["mise", "-j", "1", "select", "build", "l", "test"], ["\r"])
    assert ran(out) == ["ran-build", "ran-lint", "ran-test-e2e", "ran-test-unit"], out
elif mode == "folder":
    # The first row picks the tasks outside folders.
    out = run(["mise", "-j", "1", "run", "--select"], [" ", "\r"])
    assert ran(out) == ["ran-build", "ran-lint"], out
elif mode == "cancel":
    out = run(["mise", "select", "build"], ["\x1b"])
    assert ran(out) == [], out
print("ok")
PY

# --run needs no terminal: a folder and an alias.
assert "mise -j 1 select --run test l 2>/dev/null" "ran-lint
ran-test-e2e
ran-test-unit"
assert "mise -j 1 select --run '^test:u' build 2>/dev/null" "ran-build
ran-test-unit"
assert_fail_contains "mise select --run nope" "no task, alias, or folder named 'nope'"
assert_fail_contains "mise select --run" "--run requires task names, aliases, or folders"

assert "python3 select.py presets" "ok"
assert "python3 select.py folder" "ok"
assert "python3 select.py cancel" "ok"
